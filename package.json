{
  "name": "commbee-desktop",
  "version": "0.1.2",
  "description": "CommBee desktop — your community, in its own window.",
  "author": "CommBee",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.commbee.desktop",
    "productName": "CommBee",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "picker.html",
      "picker.cjs",
      "offline.html",
      "assets/icon.png",
      "preload.cjs",
      "desktop-services.cjs"
    ],
    "artifactName": "CommBee-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CommBee",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "Share your camera when you choose to turn it on in CommBee.",
        "NSMicrophoneUsageDescription": "Talk with your community when you enable your microphone.",
        "NSScreenCaptureUsageDescription": "Share the screen or window you select in CommBee."
      },
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "maintainer": "CommBee"
    }
  }
}
